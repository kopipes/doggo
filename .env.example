# API
NODE_ENV=development
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string

# Database
DB_PATH=./data/dogreg.db

# File storage: "local" or "s3"
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# S3 (only needed when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@provaliantgroup.com

# Frontend URL (for links in emails)
WEB_URL=http://localhost:5173
